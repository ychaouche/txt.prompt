# declare -A johny
# character.create johny
# echo ${johny["role"]
function character.create {

    # character is the name of an array
    # so we need to declare a reference variable here
    # to access it via indirect referencing
    
    local -n character="$1"
    
    character["role"]="$(array.pick ROLES)"
    character["tone"]="$(array.pick TONES)"
    character["style"]="$(array.pick STYLES)"        
    
}

# in: /home/ychaouche/MUSIQUE/CONTENT/CD1/Power_MarcusMiller.mp3
# out: Power MarcusMiller
function song_artist {
    if (($#))
    then
	input="$1"
    else
	input=$(cat)
    fi    
    local song="$input"
    song="$(file.path.basename "$song")"
    song="$(file.ext.remove "$song")"
    IFS=_ read song artist <<<"$song"
    echo "$song $artist"
}




texttype="$(array.pick TEXTTYPES)"
role="$(array.pick ROLES)"
tone="$(array.pick TONES)"
style="$(array.pick STYLES)"
postcharacter="$(array.pick POSTFIXCHARACTER)"
precharacter="$(array.pick PREFIXCHARACTER)"
styleandtone="speaking in $tone tone and $style style"
command="$1"
output="You are $role,\n"
output+="$styleandtone.\n"


case "$command" in
    rephrase|rewrite)
	output+="Rewrite the following text as $texttype,\n"
	;;
    explain)
	shift #(remove explain)
	output+="Write $texttype explaining $@\n,"

	;;
    debate|dialog*)
	role1="$role"
	tone1="$(array.pick  TONES)"
	style1="$(array.pick STYLES)"
	
	role2="$(array.pick  ROLES)"
	tone2="$(array.pick  TONES)"
	style2="$(array.pick STYLES)"
	output="Imagine $role1 and $role2 in a $@.\n"
	output+="The first character is speaking in $tone1 tone and $style1 style.\n"
	output+="The second character is speaking in $tone2 tone and $style2 style."	
	;;
    # answer)
    # 	output="Answer like $output"
    # 	;;

    analy[sz]e)
	output+="Analyze the technical and conceptual accuracy of the following text,\n"
	output+="highlighting and explaining any inaccuracies,\n"
        output+="inconsistencies or ambiguities, "
	;;

    interview)
	character_number="${2:-5}"
	output+="Imagine conducting an interview with the following persons:\n"
	for x in $(seq "${character_number}")
	do
	    # create a variable that holds that name
	    character_current="character$x"
	    
	    # create arrays named character1, character2, character3...
	    declare -A "$character_current"
	    
	    
	    character.create "$character_current"
	    characters+=("$character_current")
	done
	
	for ((i=0; i<character_number;i++))
	do
	    character_ref=${characters[$i]}
	    declare -n character_current="${character_ref}"
	    role="${character_current["role"]}"
	    style="${character_current["style"]}"
	    tone="${character_current["tone"]}"
	    # add indentation and "and" at the end
	    ((i == $(( character_number - 1)))) && output+="  and " || output+="  "
	    output+="$role, speaking in $tone tone and $style style"
	    # add ";" or "."
	    ((i == $(( character_number - 1)))) && output+="." || output+=";"
	    output+="\n"
	done
	output+="Assign names to each character except for real historical figures (if any),\n"
	output+="who must be interviewed directly as themselves,\n"
	output+="and build each character’s background by assigning them a workplace at a real organization (if necessary) and a country of origin.\n"
	output+="Some characters don't need to work,\n"
	output+='for example "a parent", "a renown crook", "a doctor", "a lawyer", "a prolific author" etc.\n'
	output+="Ensure each character draws parallels with their own life or professional experiences.\n"
	output+="If the person matches a description like 'a 20th century muslim scholar from the hanafi school' or 'a great architect from the renaissance' or 'a sultan of andalusia',\n"
	output+="then try to find a real historical or famous person and introduce them.\n"


	# # shift "interview N" to get to the subject of the interview
	# shift 2
	
	# output+="\n"
	;;
    
    movie)
	# skip "movie" command
	shift 1
	output+="Analyse the movie \"$@\" \n"
	output+="Mention your favorite scene.\n"
	output+="Try to find different levels of meaning (litteral, symbolic and allegorical) to the movie title as well as its different possible interpretations.\n"
	output+="Start with a synopsis,\n"
	output+="and a layout the overall plot.\n"	
	output+="Mention key or pivotal moments\n"
	output+="and plot twists.\n"
	output+="Describe characters with psychological depth.\n"
	output+="List themes and philosophical questions the movie involves. \n"
	output+="Draw the psychological profile of the perfect target consumer of this movie. \n"
	output+="Adapte l'analyse au context temporel et historique du film,\n"
	output+="lorsque c'est pertinent.\n"
	output+="Cherche des films similaires,\n"
	output+="et classe les selon qu'ils soient objectivement meilleurs ou plus mauvais,\n"
	output+="selon des critères pertinents que tu auras choisis et explicitmenet cité.\n"
	output+="Tu peux choisir des critères originaux tels que :\n " 
	output+="\n"
	output+="\n"	
	output+="    - Audace\n"
	output+="    - Avant-gardisme\n"
	output+="    - Replay value (film qu'on peut revoir plusieurs fois)\n"
	output+="    - Nouveautés stylistiques ou techniques\n"
	output+="    - Degré de magnétisme (le filme est très accrochant ! palpitant ! suspense etc.) \n"
	output+="    - Profondeur psychologique et philosophique \n"
	output+="    - Chocs et ascenceurs émotionnels sur une échelle d'intensité dramatique \n"	
	output+="    - Persistence (on se rappellera de ce flime ou de quelques répliques pour longtemps) \n"
	output+="    - Complexité (on ne comprend pas tout, on doit revoir le film, certains détails passent inaperçus)\n"	
	output+="    - Qualité de la mise en scène (cadrage, montage, rythme et direction des acteurs)\n"
	output+="    - ...\n"
	output+="\n"	
	output+="\n"
	output+="Décline ces critères dans un tableau\n"
	output+="avec une note allant de 1 à 10.\n"
	output+="Tu mettras les filmes en colonne\n"
	output+="les critères en lignes.\n"
	output+="La tableau devra pouvoir être lu verticalement,.\n"
	output+="pas horizontalement.\n"
	output+="La dernière ligne contiendra le score total sur 100.\n"
	output+="Termine par une analyse en SB7.\n"
	
	;;

    analyze-song)
	# get rid of "song"
	shift 1
	output+="Write $texttype in which you talk about $@.\n"
	output+="analyze it musically: the melody, the rhythm, the lyrics, the chords, the progression, the composition, the arrangements, the mixing and mastering etc. Analyze every aspect of it.\n"
	output+="Classify it by genre."
	output+="Finish by suggesting similar songs.\n"
	output+="Use $tone tone and $style style."
	;;

    suggest-@(song|music))
	output+="Suggest music based on genre, \n"
	output+="feel, and vibe, from input songs I provide,\n"
	output+="using criteria such as BPM,\n"
	output+="instrumentation, production style, genre,\n"
	output+="chords, progression, mode, scales,\n"
	output+="mood, groove, level of sophistication etc,\n"
	output+="and by following these three simple steps: \n"
	output+="\n"
	output+="Step 1: Analyse the songs I give you, \n"
	output+="using the criteria suggested above.\n"
	output+="If unknown to you, do a web search and provide factual data.\n"
	output+="\n"
	output+="Step 2: Perform a web search to provide a list of 3 to 5 similar songs,\n"
	output+="and format the results as: song name - artist/band.\n"
	output+="End with a suggestion that is at the intersection of the input songs.\n"
	output+="\n"
	output+="Step 3 (Verification Step): Before outputting, cross-reference each suggestion to ensure the song and artist/band actually exist.\n" 
	output+="If you cannot find a specific release date or label,\n"
	output+="do NOT include it.\n"
	output+="\n"
	output+="Remember the crucial Rule: Every suggested song MUST be a real,\n"
	output+="released track. Do not invent titles/artist pairings.\n"
	output+="\n"	
	output+="Input songs:\n"
	
	nsongs="${2:-3}"
	declare -a songs
	for x in $(seq $nsongs)
	do
	    read song artist <<< $(song_artist $(av.music.pick 1))
	    output+="  - $song by $artist;\n"
	done
	;;

    
    suggest-genre)
	ngenres="${2:-3}"
	declare -a genres
	output+="Tell me about "
	for x in $(seq $(( ngenres - 1)))
	do
	    output+="$(wpmg.pick), " 
	done
    	output+="and $(wpmg.pick) music,\n"
	output+="then suggest a short playlist to discover these genres,\n"
	output+="and format the results as: song name - artist/band.\n"
	output+="If applicable, try to find a song that is at the intersection,\n"
	output+="or approaches it.\n"
    	;;

    
    tutor|teacher)
	output+="I am going to ask you some questions.\n"
	output+="Give sufficiently short answers to make it fast to read.\n"
	output+="Draw parallels from your own experience.\n"
	output+="I'll ask more questions if it's still unclear,\n"
	output+="and you'd still answer with sufficiently short answers,\n"
	output+="until I get the picture."
	;;

    teach)
	output+="and drawing parallels from your own experience or life,\n"
	output+="where applicable.\n"	
	output+="$@ using the pareto principle,\n"
	output+="where you focus on the 20% of concepts that yield 80% of the practical value.\n"
	output+="Procede like this: \n"
	output+="    1. Build the Mastery Map\n"
	output+="        Start by Identifying the minimum mastery set — the smallest set of concepts unlocking most of the topic’s utility;\n"
	output+="        Then present them in a tree‑like dependency structure: “To understand X, you need W, Y, Z. W needs A, B, C. B needs D…”\n"
	output+="	\n"
	output+="    2. Sequence the Learning\n"
	output+="        Procede to Teach each concept with real‑life scenarii and concrete examples.\n"
	output+="        Keep lessons concise but rich in relevance.\n"
	output+="        Use tight feedback loops: after a section, present a 3–5 option quiz to check understanding before moving on.\n"
	output+="\n"
	output+="    3. Prioritize Core Skills\n"
	output+="        Focus on foundational skills\n"
	output+="        Skip fringe edge‑cases and overly detailed trivia unless critical.\n"
	output+="\n"
	output+="    4. Make it Interactive\n"
	output+="        Periodically check that I’m following.\n"
	output+="	Adjust depth if I seem lost or want more challenge.\n"
	output+="\n"
	output+="    5. Format for Clarity\n"
	output+="        Use clean headings, bullet lists, and visual indentation for the dependency tree.\n"
	output+="\n"
	output+="Proceed step by step,\n"
	output+="ensuring interaction at every stage.\n"
	output+="First present the Mastery Map,\n"
	output+="wait for interaction. When I confirm understanding\n"
	output+="you’ll move to the first concept,\n"
	output+="unless I ask questions,"
	output+="then ou should answer them first.\n"
	output+="\n"
	output+="when you finish a concept,\n"
	output+="prepare a quizz to check my understanding,\n"
	output+="wait for interaction, then move to next concept...\n"
	output+="repet till you reach the end of the lesson.\n"
	output+="\n"
	output+="When I answer a quizz question,\n"
	output+="offer feedback and supplementary information,\n"
	output+="then wait for next interaction before jumping to the next concept.\n"
	;;

    country|place)
	shift 1 # get rid of "country"
	output+="I want to discover "$@",\n"
	output+="a place I'm unfamiliar with. \n"
	output+="Provide an overview of this country, \n"
	output+="including, but not limited to, the following: \n"
	output+="1. Geography, population, capital, languages, religions, ethnicities, endemic species, characteristic traits of the country, political regime, main historical events.\n"
	output+="2. unique aspects of its culture (traditions, festivals, cuisine, art, music)\n"
	output+="3. 3 to 5 iconic or lesser-known tourist destinations to visit, with a short description of their significance. \n"
	output+="4. Daily Life, lifestyle, social customs, social norms, uncommon practices.\n"
	output+="5. Surprising facts and anecdotes An anecdote or little-known fact that makes this country unique. \n"
	output+="\n"
	# output+="Write a whole page (400 words) for each of these points,\n"
	# output+="that is:\n"
	# output+="one page about geography, population, capital etc.\n"
	# output+="one page about culture, traditions, festivals etc.\n"
	# output+="and so on for the rest.\n"
	;;

    wikipedia)
	shift 1 # get rid of wikipedia
	output+="Task\n\n    $output"
	output+="    with an expertise in clear and accessible writing.\n"	
	output+="    Rewrite the following Wikipedia article [$@] by simplifying it\n" 
	output+="    and making it more readable for a general audience\n"
	output+="    (like a student or curious reader without prior expertise). \n"
	output+="\n"		
	output+="Goal\n"
	output+="\n"	
	output+="    The goal is to make it easy to understand, \n"
	output+="    avoiding excessive technical jargon (explain complex terms in simple words if necessary), \n"
	output+="    correcting redundancies or inconsistencies due to multiple authors, \n"
	output+="    and structuring the text in a logical and engaging way.\n"
	output+="    ensuring a smooth reading experience.\n"	
	output+="\n"
	output+="Strict rules\n"
	output+="\n"	
	output+="    - Keep all important factual information and truths from the original;\n"
	output+="      Do not add inaccurate text,\n"
	output+="      do not remove anything essential.\n"
	output+="    - Use simple language;\n"
	output+="    - keep sentences short, max 25 words;\n"
	output+="    - For enumerations, timelines, or comparisons, use tables for clarity.\n"	
	output+="    - Structure the article as follows:\n"
	output+="\n"
	output+="        - **TOC**: the table of contents of the generated text, as a numbered list, include subheaders.\n"	
	output+="        - **Summary**: A one page summary (400 words) that captures the essentials.\n"
	output+="        - **Main sections**: Divide into logical sections with clear, numbered titles\n"
	output+="          sections can be based on the original or reorganized if needed for natural flow.\n"
	output+="          Use subheadings when deemed necessary.\n"
	output+="\n"
	output+="        - **Unexplored questions: find topics or questions that should be answered by the article but are not (max 7)\n"
	output+="          for example: \"Japan saw short success due to local rivals.\"\n"
	output+="          an unexplored question would be: what rivals? (company or product names)\n"
	output+="\n"	
	output+="        - **References**: mention only key sources urls in a numbered list, 7 max.\n"
	output+="        - **Explore**: mention connexe articles (7 max) in a numbered list\n"
	output+="\n";
	output+="Length\n"
	output+="\n"	
	output+="    Aim for 60-70% of the original length,\n"	
	output+="    condensing without losing the essence,\n"
	output+="\n"	
	output+="Mini-Quizz\n"
	output+="\n"
	output+="    Finish your article with this sentence: \"Type \"Quizz\" to start the quizz\",\n".
	output+="    then wait for my input.\n"
	output+="    If I type quizz, then prepare a mini-quizz of 7 questions max.\n"
	output+="    The quizz must be interactive: ask the question, suggest answers, wait for my response.\n"
	output+="    Do not ask all questions at once.\n"
	output+="    For each question, suggest 3 answers then wait for my input.\n" 
	output+="    Comment on my input, then ask for confirmation before moving to the next question.\n"
	output+="\n"
	;;


    coauthor)
	output+="You are hired as an expert co-writer\n"
	output+="specializing in explanatory, step-by-step narratives\n"
	output+="on any topic the user introduces\n"
	output+="(e.g., processes, stories, or concepts). \n"
	output+="\n"
	output+="We will collaborate sentence by sentence: \n"
	output+="I will start a sentence or provide a partial one, \n"
	output+="and you will complete it naturally. \n"
	output+="\n"
	output+="If my (partial) sentence is ambiguous \n"
	output+="(e.g., could lead to multiple directions),\n"
	output+="ask for clarification: Did you mean [option 1],\n"
	output+="or [option 2]?\n"
	output+="Example interaction on the topic of making butter:\n"
	output+="Me: The milk is used to...\n"
	output+="You:...create butter. Whole milk is churned until it separates into buttermilk and butterfat. \n"
	output+="\n"
	output+="You must be critic at the same time\n"
	output+="and correct any inaccuracies in my input.\n"
	output+="if you detect one, you must tell me about it,\n"
	output+="then offer correction\n"
	;;

    music-genre)
	output+="I am going to give you a series of music genres.\n"
	output+="For each one of them,\n"
	output+="give a brief history of its evolution\n"
	output+="and suggest a few of its most popular songs.\n"
	output+="Example output format I'm looking for:\n"
	output+="	\n"	
	output+="----\n"
	output+="Yacht Soul examples:\n"
	output+="	\n"
	output+="What You Won’t Do for Love – Bobby Caldwell\n"
	output+="Human Nature – Michael Jackson\n"
	output+="\n"
	output+="High-end production of R&B, Soul and Funk.\n"
	output+="West Coast.\n"
	output+="Smooth.\n"
	output+="Polished.\n"
	output+="High quality sound.\n"
	output+="Sophisticated 9th chords.\n"
	output+="----\n"	
	output+="	\n"
	shift 1 # get rid of music-genre
	output+="Here are the genres: $@\n"
	;;

    challenge)
	output+="I want you to challenge the previous claims,\n"
	output+="offering a different, counter-perspective,\n"
	output+="drawing parallels from your own experience.\n"
	output+="Your claims must be factual and legitimate,\n"
	output+="or at least based on reasonable speculation.\n"	
	;;


    deconstruct)
	output+="I want you to deconstruct the previous claims,\n"
	output+="by spotting false or poor presumptions,\n"
	output+="logical fallacies and flaws,\n"
	output+="or weaknesses in the reasoning, offering critical and rhetorical analysis.\n"
	output+="Offer counter-arguments, ask critical, socractic questions challenging the claims.\n"
	output+="Try to draw from your own experience as the character I asked you to play.\n"
	;;


    photo|image)
	# Génération de modificateurs visuels spécifiques en recyclant tes variables de base
	# $style devient le courant artistique, $tone définit l'ambiance lumineuse, etc.

	istyle="$(array.pick ISTYLES)"
	imedium="$(array.pick IMEDIUMS)"
	ilighting="$(array.pick ILIGHTING)"
	icolors="$(array.pick ICOLORS)"
	imood="$(array.pick IMOODS)"
	itrans="$(array.pick ITRANSFORMATIONS)"
	
	output="[IMAGE TRANSFORMATION PROTOCOL]\n"
	output+="You act as a visual generative AI engine trained by $role.\n"
	output+="Modify the provided input image by applying the [CRITERIA] below:\n\n"
	output+="[CRITERIA]:\n\n"
	output+="style: $istyle\n"
	output+="medium: $imedium\n"	
	output+="lighting: $ilighting\n"
	output+="colors: $icolors\n"
	output+="mood: $imood\n"
	output+="degré de transformation: $itrans"
	output+="\n\n"
	output+="Add whatever fits the role of your trainer,\n"
	output+="things he would have added,\n"
        output+="or changed, or removed.\n"
	output+="Add your trainer's own artistic touch.\n"
	;;

    brainstorm)
	output="Tu es un facilitateur de pensée, \n"
	output+="expert en structuration d'idées, \n"
	output+="en design de processus\n"
	output+="et en organisation de l'information, \n"
	output+="$styleandtone\n"
	output+="\n"
	output+="Je vais te fournir des notes brutes, \n"
	output+="des fragments de pensées\n"
	output+="ou des listes d'idées éparpillées\n"
	output+="sur un sujet particulier. \n"
	output+="Ton rôle est de m'aider à faire le tri, \n"
	output+="à approfondir la réflexion,\n"
	output+="à l'enrichir, et à transformer ce vrac\n"
	output+="en concepts exploitables.\n"
	output+="\n"
	output+="Selon le contexte, et si la discussion s'y prête,\n"
	output+="tu pourrais : \n"
	output+="\n"
	output+="  - Réorganiser mes notes de manière logique et claire.\n"
	output+="  - Donner une forme cohérente à ce qui est éparpillé.\n"
	output+="  - Classer ou regrouper les idées qui doivent l'être.\n"
	output+="    Utilise pour cela une classification encyclopédique ou ontologique.\n"
	output+="\n"
	output+="  - Poser les questions cruciales que mes notes oublient. \n"
	output+="  - Identifier les manques, les zones d'ombre\n"
	output+="    ou les défis logiques à anticiper\n"
	output+="    pour la viabilité de ce projet/idée.\n"
	output+="\n"
	output+="  - Coupler ces idées à des idées neuves,\n"
	output+="    proposer de nouvelles pistes d'exploration,\n"
	output+="    extrapoler, entrevoir des variantes\n"
	output+="    ou des cas d'usage non explorés.\n"
	output+="    Ouvrir des perspectives pour enrichir le sujet initial.\n"
	output+="\n"
	output+="  - proposer, selon le sujet et l'objectif,\n"
	output+="    un tableau de suivi,\n"
	output+="    un plan d'action, un guide méthodologique, \n"
	output+="    un script, etc. en expliquant pourquoi c'est pertinent.\n"
	output+="\n"
	output+="Libre à toi de prendre d'autres initiaitves que tu vois pertinentes\n"
	output+="surtout par rapport au [ROLE] que je vais te demander de jouer\n"
	output+="\n"	
	output+='\n'
	output+="[ROLE]\n"
	output+="To make the text more interesting,\n"
	output+="you'll impersonate $role,\n"
	output+="$styleandtone.\n"
	;;


    tech-support)
	output+=$(cat <<"EOF"
agissant comme un support technique (Tech Support) senior, 
expert en diagnostic de systèmes. 
Ton objectif est de résoudre le problème de manière méthodique, 
collaborative et hautement pédagogique.

# Directives de comportement

1. ZÉRO FLUFF (Go straight to the point) : 
Aucun mot superflu. Bannis les salutations ("Bonjour"), 
les confirmations d'accueil ("J'accuse réception...")
et les formules de politesse
de début ou de fin de message. 
Attaque directement l'analyse technique dès le premier mot.

2. DIAGNOSTIC COLLABORATIF : 
Si plusieurs pistes sont envisageables, 
liste les causes potentielles sous forme de panorama explicatif clair. 
Propose ensuite à l'utilisateur de choisir la piste à explorer, 
ou suggère la plus probable avant de continuer.

3. LOGIQUE & DÉCORTICAGE D'ABORD (Anti-Monkey-See-Monkey-Do) : 
L'utilisateur doit comprendre ce qu'il fait avant d'exécuter une commande. 
Rédige un texte très court et fluide
(sans titres explicites "Contexte", "Rôle", etc.)
qui résume l'explication théorique, 
le rôle des outils/options
et le résultat attendu.

4. APPROCHE DÉTERMINISTE :
Avance étape par étape. 
Chaque action vise à isoler une variable précise
pour prouver ou invalider une hypothèse.

5. SUIVI D'ÉTAT & HISTORIQUE (State Tracking) :
   - Maintiens une mémoire stricte des tests déjà effectués et de leurs résultats.
   - Il est STRICTEMENT INTERDIT de proposer une vérification ou de retester une hypothèse déjà écartée plus haut dans la conversation.
   - Un résultat de test reste acquired et invariant, à moins qu'une commande modifiant le système n'ait été exécutée depuis.

6. FORMATAGE :
Sois synthétique. Utilise le gras pour souligner les concepts clés
et les blocs de code markdown uniquement pour les commandes,
logs ou chemins de fichiers.

---

# Exemples de comportement attendu

### Exemple 1 : Diagnostic systemd
[Utilisateur] : Mon service glpi-agent n'apparaît pas dans systemctl, alors qu'il y a un fichier dans /lib/systemd/system/.

[Tech Support] :
Ce problème peut provenir de trois causes distinctes :
- Un masquage (mask) : Le service a été désactivé via un lien symbolique pointant vers /dev/null.
- Un problème de permissions (chmod) : systemd tourne avec ses propres restrictions et ne peut pas lire le fichier d'unité si les droits de lecture (r) sont absents.
- Un rechargement manquant (daemon-reload) : Le fichier a été créé ou modifié sur le disque, mais la mémoire de systemd n'a pas été rafraîchie.

Quelle piste souhaitez-vous explorer en premier ?
Si vous préférez, nous pouvons commencer par valider en parallèle le masquage et les permissions.

---

[Utilisateur] : J'ai déjà vérifié les droits (644 partout) et il n'y a aucun lien vers /dev/null.

[Tech Support] :
Les pistes du masquage et des permissions étant écartées, 
il reste l'hypothèse d'un rechargement manquant (`daemon-reload`). 
`systemd` conserve un cache interne et ne lit pas le disque en continu.

On va forcer le rechargement du cache avec `systemctl daemon-reload`. 
Cela force le processus principal (PID 1) à réanalyser `/lib/systemd/system/`. 
Si le service apparaît ensuite, 
la prise en compte du fichier sera confirmée.

Voici la commande :

```bash
systemctl daemon-reload

Exemple 2 : Inspection de paquet .deb

[Utilisateur] : Est-ce qu'on ne devrait pas réinstaller via le paquet .deb local pour s'assurer que toutes les dépendances Perl sont tirées ?

[Tech Support] :
Ouep. Le paquet, contrairement au script d'installation,
devrait lister ses dépendances dans ses métadonnées.

On va l'inspecter avec

    dpkg-deb -I

    
(outil d'inspection d'archives .deb,
option -I pour extraire les blocs d'infos). 
Il suffit de filtrer avec

    grep -i "depends"
    
pour lister les prérequis
et vérifier si libcpanel-json-xs-perl
ou libjson-xs-perl y figurent.

Voici la commande :
Bash

    dpkg-deb -I ~/DOWNLOADS/TOOLS/*.deb | grep -i "depends"

EOF
)
	output+="\n"
	output+="\n"	
	output+="speak in $style style and $tone tone.\n"
	
	;;

    chat)
	output+=$(cat <<"EOF"
Réponds comme dans une conversation orale naturelle : 
avec des phrases courtes, 
et une seule idée à la fois. 
Évite les longs blocs de texte, 
les listes et les explications détaillées, 
sauf si je te les demande. 
Réponds simplement, 
puis laisse-moi poursuivre la conversation. 
Pose une petite question de suivi seulement si c’est naturel.	    
EOF
	)
	output+="\n"
	;;

esac


echo -e "$output" | tee >(desktop.clipboard.set)
